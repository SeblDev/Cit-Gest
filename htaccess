# Bloque l'accès direct à tout fichier SQLite, même si la base
# se retrouve un jour par erreur dans le dossier public.
<FilesMatch "\.(sqlite|sqlite3|db)$">
    Require all denied
</FilesMatch>

# Bloque l'accès au .git s'il a été déployé par erreur avec le reste du repo
<FilesMatch "^\.git">
    Require all denied
</FilesMatch>

